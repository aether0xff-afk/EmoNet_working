from __future__ import annotations

from dataclasses import dataclass, field
from typing import Any, Mapping

from .emotion import InputSignals
from .models import EmotionState, clamp


@dataclass(frozen=True)
class ActivationSignature:
    weights: dict[str, float] = field(default_factory=dict)

    @classmethod
    def from_runtime(
        cls,
        *,
        emotion_state: EmotionState,
        signals: InputSignals,
        trace_record: Mapping[str, Any] | None = None,
    ) -> "ActivationSignature":
        weights = {
            "emotion:valence": abs(float(emotion_state.valence)),
            "emotion:arousal": float(emotion_state.arousal),
            "emotion:affinity": float(emotion_state.affinity),
            "emotion:stability_inverse": 1.0 - float(emotion_state.stability),
            "emotion:protective_tension": float(emotion_state.protective_tension),
            "emotion:curiosity": float(emotion_state.curiosity),
            "signal:alarm": float(signals.alarm),
            "signal:warmth": float(signals.warmth),
            "signal:action_pressure": float(signals.action_pressure),
            "signal:curiosity": float(signals.curiosity),
            "signal:intensity": float(signals.intensity),
        }
        if trace_record:
            for index, value in enumerate(trace_record.get("stim_vec", [])[:8]):
                weights[f"trace:stim:{index}"] = float(value)
        return cls(weights={name: round(clamp(value, 0.0, 1.0), 4) for name, value in weights.items()})

    @classmethod
    def from_mapping(cls, payload: Mapping[str, Any] | None) -> "ActivationSignature":
        if not isinstance(payload, Mapping):
            return cls()
        weights = payload.get("weights", payload)
        if not isinstance(weights, Mapping):
            return cls()
        return cls(weights={str(name): round(clamp(float(value), 0.0, 1.0), 4) for name, value in weights.items()})

    def to_record(self) -> dict[str, Any]:
        return {"weights": dict(self.weights)}
```

