@dataclass(frozen=True)
class NeuralMemoryBinding:
    memory_id: str
    signature: ActivationSignature
    recall_count: int = 0
    cooldown: float = 0.0

    @classmethod
    def from_mapping(cls, payload: Mapping[str, Any]) -> "NeuralMemoryBinding":
        return cls(
            memory_id=str(payload.get("memory_id", "")).strip(),
            signature=ActivationSignature.from_mapping(payload.get("signature")),
            recall_count=int(payload.get("recall_count", 0)),
            cooldown=clamp(float(payload.get("cooldown", 0.0)), 0.0, 1.0),
        )

    def to_record(self) -> dict[str, Any]:
        return {
            "memory_id": self.memory_id,
            "signature": self.signature.to_record(),
            "recall_count": self.recall_count,
            "cooldown": self.cooldown,
        }


@dataclass(frozen=True)
class NeuralRecallCandidate:
    memory_id: str
    score: float
    reason: str

    def to_record(self) -> dict[str, Any]:
        return {"memory_id": self.memory_id, "score": self.score, "reason": self.reason}


@dataclass(frozen=True)
class NeuralMemoryIndex:
    bindings: tuple[NeuralMemoryBinding, ...] = ()

    @classmethod
    def from_mapping(cls, payload: Mapping[str, Any] | None) -> "NeuralMemoryIndex":
        if not isinstance(payload, Mapping):
            return cls()
        bindings = payload.get("bindings", ())
        return cls(tuple(NeuralMemoryBinding.from_mapping(item) for item in bindings if isinstance(item, Mapping)))

    def bind_memory(self, memory_id: str, signature: ActivationSignature) -> "NeuralMemoryIndex":
        clean_id = str(memory_id).strip()
        next_binding = NeuralMemoryBinding(memory_id=clean_id, signature=signature)
        kept = tuple(binding for binding in self.bindings if binding.memory_id != clean_id)
        return NeuralMemoryIndex(bindings=(*kept, next_binding))

    def recall(self, signature: ActivationSignature, *, limit: int = 5, threshold: float = 0.35) -> tuple[NeuralRecallCandidate, ...]:
        candidates = []
        for binding in self.bindings:
            score = _signature_similarity(signature, binding.signature) * (1.0 - binding.cooldown)
            if score >= threshold:
                candidates.append(
                    NeuralRecallCandidate(
                        memory_id=binding.memory_id,
                        score=round(score, 4),
                        reason="activation_signature_similarity",
                    )
                )
        candidates.sort(key=lambda item: item.score, reverse=True)
        return tuple(candidates[: max(0, int(limit))])

    def to_record(self) -> dict[str, Any]:
        return {"bindings": [binding.to_record() for binding in self.bindings]}


def _signature_similarity(left: ActivationSignature, right: ActivationSignature) -> float:
    keys = set(left.weights) | set(right.weights)
    if not keys:
        return 0.0
    distance = sum(abs(left.weights.get(key, 0.0) - right.weights.get(key, 0.0)) for key in keys) / len(keys)
    return clamp(1.0 - distance, 0.0, 1.0)
```

