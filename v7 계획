def _merge_memories(left: tuple[MemoryItem, ...], right: tuple[MemoryItem, ...]) -> tuple[MemoryItem, ...]:
    merged = []
    seen = set()
    for item in (*right, *left):
        if item.memory_id in seen:
            continue
        seen.add(item.memory_id)
        merged.append(item)
    return tuple(merged)
```

