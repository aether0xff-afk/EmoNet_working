import json
from pathlib import Path


class NeuralMemoryIndexStore:
    def __init__(self, path: Path) -> None:
        self.path = path

    def load(self) -> NeuralMemoryIndex:
        if not self.path.exists():
            return NeuralMemoryIndex()
        payload = json.loads(self.path.read_text(encoding="utf-8"))
        if not isinstance(payload, Mapping):
            raise ValueError(f"neural memory file must contain an object: {self.path}")
        return NeuralMemoryIndex.from_mapping(payload)

    def save(self, index: NeuralMemoryIndex) -> None:
        self.path.parent.mkdir(parents=True, exist_ok=True)
        self.path.write_text(json.dumps(index.to_record(), ensure_ascii=False, indent=2), encoding="utf-8")
```

